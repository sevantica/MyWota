            "preLaunchTask": "MyWota - Build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set target remote hardware",
                    "text": "set mem inaccessible-by-default off",
                    "ignoreFailures": true
                }
            ],
            "postRemoteConnectCommands": [
                {
                    "description": "Reset and halt target",
                    "text": "monitor reset halt",
                    "ignoreFailures": false
                },
                {
                    "description": "Set breakpoint at main",
                    "text": "-break-insert main",
                    "ignoreFailures": true
                },
                {
                    "description": "Run from ROM boot through bootloader to app breakpoint",
                    "text": "monitor reset",
                    "ignoreFailures": false
                }
            ],
            "launchCompleteCommand": "None",
            "logging": {
                "engineLogging": false,
